"use client";

import { useEffect, useState } from "react";
import { createClient } from "@supabase/supabase-js";
import Link from "next/link";

export default function DashboardPage() {
  const [email, setEmail] = useState("");
  const [loading, setLoading] = useState(true);
  const [message, setMessage] = useState("");

  useEffect(() => {
    async function checkUser() {
      const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
      const key = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;

      if (!url || !key) {
        setMessage("Configuration Supabase manquante.");
        setLoading(false);
        return;
      }

      const supabase = createClient(url, key);
      const { data, error } = await supabase.auth.getUser();

      if (error || !data.user) {
        window.location.href = "/login";
        return;
      }

      setEmail(data.user.email ?? "");
      setLoading(false);
    }

    checkUser();
  }, []);

  async function handleLogout() {
    const url = process.env.NEXT_PUBLIC_SUPABASE_URL;
    const key = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;

    if (!url || !key) return;

    const supabase = createClient(url, key);
    const { error } = await supabase.auth.signOut({ scope: "local" });

    if (error) {
      setMessage("La déconnexion a échoué. Réessayez.");
      return;
    }

    window.location.href = "/login";
  }

  if (loading) {
    return <main className="container hero">Chargement de votre espace...</main>;
  }

  return (
    <main>
      <header className="header">
        <div className="container header-content">
          <div className="logo">FASO CLOUD FREE</div>
          <button className="btn" onClick={handleLogout}>
            Déconnexion
          </button>
        </div>
      </header>

      <section className="container hero">
        <h1>Mon tableau de bord</h1>
        <p>Bienvenue dans votre espace client FASO CLOUD Free.</p>
      </section>

      <section className="container grid">
        <article className="card">
          <h2>Mon profil</h2>
          <p>Adresse e-mail : {email}</p>
          <p>Compte connecté</p>
        </article>

        <article className="card">
          <h2>Services Bitcoin</h2>
          <p>Les informations sur les services seront ajoutées après leur intégration.</p>
        </article>

        <article className="card">
          <h2>Mon activité</h2>
          <p>Votre historique et vos données seront disponibles après configuration.</p>
        </article>
      </section>

      <div className="container" style={{ textAlign: "center", paddingBottom: 30 }}>
        <p role="status">{message}</p>
        <Link href="/">Retour à l'accueil</Link>
      </div>
    </main>
  );
}
