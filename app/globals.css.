app/globals.css.

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  color-scheme: dark;
  --background: #07111f;
  --surface: #101f32;
  --green: #18c784;
  --text: #f5f7fa;
  --muted: #a6b4c5;
}

body {
  min-height: 100vh;
  background: var(--background);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

button, input {
  font: inherit;
}

.container {
  width: min(1100px, 92%);
  margin: auto;
}

.header {
  padding: 22px 0;
  border-bottom: 1px solid #26364a;
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.logo {
  color: var(--green);
  font-size: 22px;
  font-weight: 800;
}

.hero {
  padding: 75px 0 45px;
  text-align: center;
}

.hero h1 {
  font-size: clamp(30px, 6vw, 52px);
  margin-bottom: 18px;
}

.hero p {
  color: var(--muted);
  line-height: 1.7;
  max-width: 650px;
  margin: auto;
}

.accent {
  color: var(--green);
}

.card {
  background: var(--surface);
  border: 1px solid #26364a;
  border-radius: 16px;
  padding: 25px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
  padding: 25px 0 60px;
}

.card h2 {
  font-size: 19px;
  margin-bottom: 12px;
}

.card p {
  color: var(--muted);
  line-height: 1.6;
}

.btn {
  display: inline-block;
  border: 0;
  border-radius: 9px;
  background: var(--green);
  color: #06150f;
  padding: 13px 22px;
  font-weight: 700;
  cursor: pointer;
}

.hero .btn {
  margin-top: 25px;
}

.footer {
  border-top: 1px solid #26364a;
  padding: 25px 0;
  color: var(--muted);
  text-align: center;
  font-size: 13px;
}

@media (max-width: 600px) {
  .hero {
    padding-top: 50px;
  }

  .card {
    padding: 20px;
  }
}
